# Database (Supabase Postgres — Transaction pooler for the app)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: Session/direct URI for drizzle-kit push/pull (port 5432). If omitted, kit auto-rewrites 6543→5432.
# DATABASE_URL_DIRECT=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_URL_SESSION=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Cache
REDIS_URL=redis://localhost:6379

# TMDB
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Optional watch-provider region (default US)
# TMDB_WATCH_REGION=US

# OMDB — free aggregator for IMDb + Rotten Tomatoes + Metacritic
# Get a key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# Gemini AI (generation + embeddings)
GEMINI_API_KEY=your_gemini_api_key

# Better Auth
BETTER_AUTH_SECRET=generate_32_char_random_string_here
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
# Optional — source map uploads in CI
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project
# SENTRY_AUTH_TOKEN=

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
# Set true only for local testing (disables email verification). Keep false in production.
RESEND_ALLOW_TEST_MODE=false
NEXT_PUBLIC_RESEND_ALLOW_TEST_MODE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional — seed script pages (default 3)
# SEED_PAGES=3
